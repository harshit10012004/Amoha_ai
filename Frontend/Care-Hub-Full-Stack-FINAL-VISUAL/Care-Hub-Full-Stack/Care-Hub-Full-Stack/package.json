{
  "name": "care-hub-full-stack",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "workspaces": ["backend"],
  "scripts": {
    "dev": "vite",
    "dev:frontend": "vite",
    "dev:backend": "npm --prefix backend run dev",
    "dev:all": "concurrently -k -n FRONTEND,BACKEND -c blue,green \"npm run dev:frontend\" \"npm run dev:backend\"",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "backend:start": "npm --prefix backend start",
    "backend:install": "npm --prefix backend install"
  },
  "dependencies": {
    "dexie": "^4.0.8",
    "i18next": "^23.16.8",
    "lucide-react": "^0.468.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-i18next": "^15.1.3",
    "react-router-dom": "^7.0.2"
  },
  "devDependencies": {
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "concurrently": "^9.1.2",
    "typescript": "~5.6.2",
    "vite": "^6.0.1",
    "vite-plugin-pwa": "^0.21.1"
  }
}
